function business_plus_preprocess_block(&$variables) {
  // var_dump($variables['plugin_id'], 'plugin id');

  if ($variables['plugin_id'] === 'system_branding_block') {

    $fid = theme_get_setting('site_logo_dol');
    if ($fid) {
      $file = File::load($fid[0]);
      if ($file) {
        $path = \Drupal::service('file_url_generator')->generateAbsoluteString($file->getFileUri());
        $variables['site_logo_dol'] = $path;
      }
    }
    // var_dump($variables['site_logo_dol'], 'is site_logo_dol present?');

  }
}

