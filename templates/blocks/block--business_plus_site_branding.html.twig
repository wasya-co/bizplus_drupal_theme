
{% set front_page = url('<front>') %}
<div class="block-business-plus-site-branding">
  {% if site_name or site_slogan %}
    <div class="site-branding__text navbar-brand">
      {% if site_name %}
        <h2>{{ site_name }}</h2>
      {% else %}
      {% if site_logo %}
        <a class="navbar-brand" href="{{ front_page }}" title="{{ 'Home'|t }}">
          <img src="{{ site_logo }}"     class="img-fluid site-logo"      alt="Home" />
          <img src="{{ site_logo_dol }}" class="img-fluid site-logo-dol"  alt="Creek Enterprise Logo" />
        </a>
      {% endif %}
      {% endif %}
      {% if site_slogan %}
        <div class="site-branding__slogan">{{ site_slogan }}</div>
      {% endif %}
    </div>
  {% elseif site_slogan and site_logo %}
    <a class="navbar-brand" href="{{ front_page }}" title="{{ 'Home'|t }}">
      <img src="{{ site_logo }}"     class="img-fluid site-logo"      alt="Home" />
      <img src="{{ site_logo_dol }}" class="img-fluid site-logo-dol"  alt="Creek Enterprise Logo" />
    </a>
    <div class="site-branding__slogan">{{ site_slogan }}</div>
  {% else %}
    {% if site_logo %}
      <a class="navbar-brand" href="{{ front_page }}" title="{{ 'Home'|t }}">
