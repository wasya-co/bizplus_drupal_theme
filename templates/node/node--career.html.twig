<section class="page-careers">
    <div class="container">
        <div class="careers-details-block">
            <div class="details-wrapper">
                <h2>{{content.field_details_title.0}}</h2>
                {{content.field_details.0}}
                <ul class="list-unstyled career-list">
                    <li><p>Location: <span>{{content.field_location.0}}</span></p></li>
                    <li><p>Job Type: <span>{{content.field_job_ty.0}}</span></p></li>
                    <li><p>Salary: <span>{{content.field_salary.0}}</span></p></li>
                </ul>
            </div>
            <div class="requirement-wrapper">
                <h2>{{content.field_sub_title.0}}</h2>
                {{content.field_description.0}}
                <div class="lists-block">
                    <div class="list1">
                        <ul class="list-unstyled">
                            {% for key, value in content.field_list['#items']%}
                            <li>
                                <div class="list-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="150" height="150" viewBox="0 0 150 150">
                                        <path data-name="Path 39261" d="M123,48a75,75,0,1,0,75,75A74.989,74.989,0,0,0,123,48ZM111.426,149.575a4.974,4.974,0,0,1-3.173,1.587,5.2,5.2,0,0,1-3.209-1.623L84.851,129.346l6.418-6.418,17.019,17.019,45-45.324,6.31,6.526Z" transform="translate(-48 -48)" fill="#111"></path>
                                    </svg>
                                </div>
                                <p>{{content.field_list[key]}}</p>
                            </li>
                            {% endfor %}
                            
                        </ul>
                    </div>
                </div>
            </div>
            <div class="form-wrapper">
                {{content.field_career_form}}
            </div>
        </div>
    </div>
</section>   