                </svg>{{nextnodedate}}
              </p>
            </div>
            <div class="img-wrapper" data-aos="fade-up" data-aos-duration="700">
              <a href="{{next_url}}" title="Details page">
                <img src="{{file_url(nextImage)}}" alt="Blog-Image"/>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>