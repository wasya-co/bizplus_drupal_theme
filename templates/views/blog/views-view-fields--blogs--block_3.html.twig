
<div class="col-md-3 col-sm-6" data-aos="fade-up">
    <div class="content-block">
        <div class="img-wrapper">
            <a href="{{fields.view_node.content}}" title="Blog-Details">
                <img src="{{fields.field_image.content}}" alt="Blog-Image"/>
            </a>
        </div>
        <div class="content-wrapper">
            <h5 class="title-link"><a href="{{fields.view_node.content}}" title="{{fields.view_node_1.content}}">{{fields.title.content}}</a></h5>
            <div class="blog-area">
                <p>{{fields.created.content}}</p>
                <p>{{fields.comment_count.content}}</p>
            </div>
            <p class="para">{{fields.field_description.content|striptags}}</p>
            <a class="read" href="{{fields.view_node.content}}" title="{{fields.view_node_1.content}}">{{fields.view_node_1.content}}</a>
        </div>
    </div>
</div>