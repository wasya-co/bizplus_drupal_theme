<div class="col-md-4 col-sm-6 aos-init aos-animate" data-aos="fade-up" data-aos-duration="1200">
    <div class="team-area">
        <div class="full-wrapper">
            <div class="img-wrapper">
                <img src="{{ fields.field_image.content|striptags|trim }}" alt="{{ fields.field_image_1.content }}">
            </div>
            <div class="content-wrapper">
                <h4>{{ fields.title.content}}</h4>
                <span>{{ fields.field_designation.content}}</span>
                {{ fields.body.content}}
            </div>
        </div>
        <div class="social-icons">
            {{ fields.field_social_media.content }}
        </div>
    </div>
</div>