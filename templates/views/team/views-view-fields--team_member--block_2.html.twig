<div class="col-md-4 col-sm-6 aos-init aos-animate" data-aos="fade-up" data-aos-duration="200">
    <div class="full-wrapper">
        <div class="img-wrapper">
            <img src="{{ fields.field_image.content }}" alt="{{ fields.field_image_1.content }}">
        </div>
        <div class="content-wrapper">
            <div class="social-icons">
                {{ fields.field_social_media.content }}
            </div>
            <div class="name-role">
                <h5>{{ fields.title.content}}</h5>
                <span>{{ fields.field_designation.content}}</span>
            </div>
        </div>
    </div>
</div>