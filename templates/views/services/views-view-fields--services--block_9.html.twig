<div class="col-md-4 col-sm-6 card-v1 aos-init aos-animate" data-aos="fade-up" data-aos-duration="1200">
  <div class="img-wrapper">
    <a class="title"
       href="{{ fields.view_node.content|striptags|trim }}"
       title="{{ fields.view_node_1.content|striptags|trim }}"
