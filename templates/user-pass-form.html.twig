{% set base_url = url('<front>')  %}
<!-- Register Page banner -->
{% if reset_banner_title %}
    <section class="page-title page-title-padd" style="background-image: url({{ resetpassword_banner_img }}); background-repeat: no-repeat; background-size: cover;background-position: center;position: relative;">
        <div class="container">
            <div class="page-title-block">
                <h1>{{ reset_banner_title }}</h1>
                <p><a href="{{ base_url }}" title="Home">Home</a> / <span>{{ reset_banner_title }}</span></p>
            </div>
        </div>
    </section>
{% endif %}
<!-- Password Reset Section Start-->
<section class="page-forgot">
    <div class="container">
        <div class="page-form-block">
            <div class="form-wrapper" style="background-image: url('{{ resetpassword_bg_img }}');background-repeat: no-repeat;background-position: center;background-size: cover;">
                <div class="content-wrapper">
                    <h2>{{ reset_page_title }}</h2>
                    <div class="form">
                        <div class="form-group">
                            {{ form.name }}
                            {{ form.mail }}
                        </div>
                        <div class="forgot-password-btn">
                            {{ form.actions }}
                            {{ form.form_build_id }}
                            {{ form.form_id }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Password Reset Section Ends-->