<section class="home3 home3-CTA">
    <div class="container">
        <div class="home3-CTA-block" style="background-image: url({{file_url(content.field_background_image['#items'].entity.uri.value)}});background-repeat: no-repeat;background-position: center;background-size: cover;">
            <div class="CTA-content">
                <div class="content-wrapper">
                    <h2>{{ content.field_title.0 }}</h2>
                    {{ content.field_description.0 }}
                </div>
                <a href="{{content.field_button_link.0['#url']}}" title="Get Quote" class="btn btn-primary">{{content.field_button_link.0['#title']}}</a>
            </div>
        </div>
    </div>
</section>