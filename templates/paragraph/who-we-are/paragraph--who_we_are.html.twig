<section class="home3 home3-whychoose">
    <div class="container">
        <div class="home3-whychoose-block">
            <div class="text-center aos-init aos-animate" data-aos="zoom-in">
                <h2>{{ content.field_title.0  }}</h2>
            </div>
            <div class="row">
                <div class="col-md-6 aos-init aos-animate" data-aos="fade-up">
                    <div class="img-wrapper">
                        <img class="img-fluid" src="{{ file_url(content.field_image['#items'].entity.uri.value)}}" alt="{{ content.field_image['#items'].alt }}" title="{{ content.field_image['#items'].title }}">
                    </div>
                </div>
                <div class="col-md-6 aos-init aos-animate" data-aos="fade-up">
                    <div class="content-wrapper">
                        <h3>{{ content.field_sub_title.0 }}</h3>
                        {{ content.field_description.0 }}
                        <ul class="list-unstyled">
                            {% for key,item in content.field_list['#items'] %}
                                <li>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="150" height="150" viewBox="0 0 150 150">
                                        <path data-name="Path 39261" d="M123,48a75,75,0,1,0,75,75A74.989,74.989,0,0,0,123,48ZM111.426,149.575a4.974,4.974,0,0,1-3.173,1.587,5.2,5.2,0,0,1-3.209-1.623L84.851,129.346l6.418-6.418,17.019,17.019,45-45.324,6.31,6.526Z" transform="translate(-48 -48)" fill="#111"/>
                                    </svg>
                                    <h4>{{ content.field_list[key]}}</h4>
                                </li>
                            {% endfor %}   
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>