{% if content.field_team_style.0['#markup'] in 'about-team' %}
    <section class="home2 home2-team page-team">
{% else %}
    <section class="home2 home2-team">
{% endif %}
    <div class="container">
        <div class="home2-team-block">
            <div class="text-center aos-init aos-animate" data-aos="zoom-in">
                <h2>{{ content.field_title.0 }}</h2>
            {{ content.field_description.0 }}
            </div>
            {{ content.field_team_style_2 }}
            <a href="{{ content.field_button_link.0['#url'] }}" title="{{ content.field_button_link.0['#title'] }}" class="btn btn-primary center-btn">{{ content.field_button_link.0['#title'] }}</a> 
        </div>
    </div>
</section>