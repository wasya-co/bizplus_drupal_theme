<section class="home3 home3-about" style="background-image: url('{{ content.field_bg_svg.0 }}');background-repeat: no-repeat;background-position: center;background-size: cover;">
    <div class="container">
        <div class="home3-about-block">
            <div class="row">
                <div class="col-md-6 aos-init aos-animate" data-aos="fade-up">
                    <div class="about-content">
                        <span>{{ content.field_tagline.0 }}</span>
                        <h2>{{ content.field_title.0 }}</h2>
                        <a href="{{ content.field_button_link.0['#url'] }}" title="{{ content.field_button_link.0['#title'] }}" class="btn btn-primary top-btn">{{ content.field_button_link.0['#title'] }}</a>
                    </div>
                </div>
                <div class="col-md-6 aos-init aos-animate" data-aos="fade-up">
                    <div class="content-wrapper">
                        {{ content.field_description.0 }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>