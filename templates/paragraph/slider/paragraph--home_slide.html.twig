{% set paragraph_parent = paragraph.getParentEntity() %}
{% set variant = paragraph_parent.field_slider_style.value %}
{% if variant in 'style2' %}
    <li class="carousel-item">
        <div class="content-wrapper">
            {% if content.field_title.0 is not empty %}
              <h2>{{content.field_title.0}}</h2>
            {% endif %}
            {% if content.field_description.0 is not empty %}
              {{content.field_description.0}}
            {% endif %}
            {% if content.field_button_link.0 is not empty %}
              <a href="{{content.field_button_link.0['#url']}}" title="Get Quote"
                 class="btn btn-primary left-btn">{{content.field_button_link.0['#title']}}</a>
            {% endif %}
        </div>
    </li>
{% elseif variant in 'style3' %}
    <div class="swiper-slide">
        <div class="info-wrapper">
            {% if content.field_title.0 is not empty %}
              <h2>{{content.field_title.0}}</h2>
            {% endif %}
            {% if content.field_button_link.0 is not empty %}
              <a href="{{content.field_button_link.0['#url']}}" title="Get Quote"
                 class="btn btn-primary">{{content.field_button_link.0['#title']}}</a>
            {% endif %}
        </div>
    </div>
{% endif %}

