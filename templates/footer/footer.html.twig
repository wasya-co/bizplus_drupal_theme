<footer class='main-footer' style="background-image: url({{footer_bg_img}})" >
    <div class="footer-top" >

      <div class="container">
        <div class="footer-block">
          <div class="top-order">
            {% if page.header %}
              {{page.header}}
            {% endif %}
            <h2>{{footer_description}}</h2>
          </div>
          <div class="bottom-order">
            <div class="row">
              <div class="col-md-6 col-lg-4 company">
                <h3>{{address_title}}</h3>
                <ul class="list-unstyled">

                  {% if address %}
                  <li>
                    <svg xmlns="http://www.w3.org/2000/svg" width="114" height="150" viewbox="0 0 114 150">
                      <path data-name="Path 39253" d="M249.5,17.5A57.393,57.393,0,0,0,209.2,33.974,55.877,55.877,0,0,0,192.5,73.747c0,39.623,50.667,89.81,52.5,91.935a6.393,6.393,0,0,0,8.931,0c1.9-2.125,52.567-52.312,52.567-91.935a55.876,55.876,0,0,0-16.694-39.773A57.394,57.394,0,0,0,249.5,17.5Zm0,75a19.134,19.134,0,0,1-13.436-5.491,18.577,18.577,0,0,1,0-26.517,19.184,19.184,0,0,1,26.872,0,18.578,18.578,0,0,1,0,26.517A19.134,19.134,0,0,1,249.5,92.5Z" transform="translate(-192.502 -17.5)" fill="#111"></path>
                    </svg>
                    <p>{{address}}</p>
                  </li>
                  {% endif %}

                  {% if phone %}
                  <li>
                    <svg xmlns="http://www.w3.org/2000/svg" width="136.363" height="150" viewbox="0 0 136.363 150">
                      <path data-name="Path 39254" d="M181.343,149.65a60.345,60.345,0,0,1-27.148-11.443,154.045,154.045,0,0,1-25.527-23.457c-9.388-10.5-18.948-20.861-27.233-32.44-6.522-9.3-12.355-19.046-15.538-30.25A49.839,49.839,0,0,1,84.206,29.97c1.434-8.834,5.9-16.018,12.025-22.032a51.5,51.5,0,0,1,8.184-6.254,10.148,10.148,0,0,1,11.581.2A43.078,43.078,0,0,1,133.7,24.09a8.371,8.371,0,0,1,.639,4.186,8.257,8.257,0,0,1-1.485,3.943c-2.05,2.895-4.185,5.714-6.249,8.609-1.821,2.564-3.712,5.084-5.332,7.783h0a7.441,7.441,0,0,0,.071,8.4c4.085,6,8.04,12.178,12.484,17.892a223.324,223.324,0,0,0,26.6,28.841c2.15,1.934,4.457,3.645,6.751,5.4a6.308,6.308,0,0,0,3.383,1.4,6.223,6.223,0,0,0,3.568-.735,77.416,77.416,0,0,0,7.167-4.2c3.21-2.145,6.364-4.349,9.517-6.463a8.055,8.055,0,0,1,8.743-.18,43.555,43.555,0,0,1,18.919,19.5,12.452,12.452,0,0,1,1.513,6.97,12.312,12.312,0,0,1-2.544,6.633c-7.926,10.888-18.059,17.607-31.533,17.907a42.562,42.562,0,0,1-4.572-.315Z" transform="translate(-83.664 0.035)" fill="#111"></path>
                    </svg>
                    <a href="tel:{{phone}}" title="Call To">{{phone}}</a>
                  </li>
                  {% endif %}

                  {% if email %}
                  <li>
                    <svg xmlns="http://www.w3.org/2000/svg" width="183.334" height="150" viewbox="0 0 183.334 150">
                      <path data-name="Icon ionic-md-mail" d="M168.122,5.625H19.711c-9.6,0-17.461,8.181-17.461,18.182V137.443c0,10,7.857,18.182,17.461,18.182H168.122c9.6,0,17.461-8.181,17.461-18.182V23.807C185.583,13.806,177.727,5.625,168.122,5.625ZM165.94,44.262l-72.024,50-72.024-50V26.08l72.024,50,72.024-50Z" transform="translate(-2.25 -5.625)" fill="#111"></path>
                    </svg>
                    <a href="mailto:{{email}}" title="Mail TO">{{email}}</a>
                  </li>
                  {% endif %}

                </ul>
              </div>
              <div class="col-md-6 col-lg-4 links footer2-links">
                <h3>{{footer_links_title}}</h3>
                <div class="row">
                  {% if page.footer_second %}
                    {{page.footer_second}}
                  {% endif %}
                </div>
              </div>
              {% if page.footer_third %}
                <div class="col-md-6 col-lg-4 connect">
                  {{page.footer_third}}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>

    </div>
    <div class="footer-bottom">

      <div class="container">
        <div class="footer-bottom-block">
          <p class="copyrights">{{ copyrights|striptags }}
            <a href="{{ copyrights_link }}" title="{{ copyrights_text }}" target="_blank">{{ copyrights_text }}</a>
          </p>
          {% if page.footer_fifth %}
            {{page.footer_fifth}}
          {% endif %}

        </div>
      </div>

    </div>
</footer>
<button class="btn btn-primary scroll-top" data-scroll="up" type="button" style="display: inline-block;">
  <i class="fa fa-chevron-up" aria-hidden="true"></i>
</button>
